# Образец настроек. Копия этого файла под именем .env заполняется своими значениями,
# сам .env в git не попадает.

# ключ создаётся на platform.openai.com/api-keys
OPENAI_API_KEY=

# адрес локальной Ollama (по умолчанию такой же)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# токен бота из @BotFather (нужен только для Telegram-бота)
TELEGRAM_BOT_TOKEN=
